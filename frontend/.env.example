# ─────────────────────────────────────────────────────────────────────────────
# Nestora Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Development: http://localhost:5000/api/v1
# Production:  https://your-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://apex-living.onrender.com/api/v1

# Public frontend URL (used for links, redirects, and SEO)
# Development: http://localhost:3000
# Production:  https://your-frontend.onrender.com
NEXT_PUBLIC_APP_URL=https://apex-living.onrender.com

# Supabase Auth (Google sign-in)
