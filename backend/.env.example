# ─────────────────────────────────────────────────────────────────────────────
# Nestora Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000

# Database (PostgreSQL / Aiven)
DATABASE_URL=

# CORS — must match the frontend origin exactly (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# ── Image storage (Phase 4) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Paystack (Phase 6) ────────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_...) during development
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# The URL Paystack redirects to after payment (should be your /payment/success page)
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/success

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# Sign up at https://app.brevo.com → Settings → SMTP & API → API Keys
# EMAIL_FROM must be a sender verified in Brevo. Until nestora.ng is owned,
# use an eligible verified address from your Brevo account.
EMAIL_PROVIDER=brevo
EMAIL_PROVIDER_API_KEY=your_new_brevo_api_key
EMAIL_PROVIDER_URL=https://api.brevo.com/v3/smtp/email
EMAIL_FROM=your_verified_sender@example.com
EMAIL_FROM_NAME=Nestora
# Configure a random value in Brevo's webhook URL query/header configuration.
EMAIL_WEBHOOK_SECRET=
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=3

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often the background job processor polls the DB (milliseconds)
JOB_POLL_INTERVAL_MS=60000
