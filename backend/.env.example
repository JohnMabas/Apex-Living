# ─────────────────────────────────────────────────────────────────────────────
# Nestora Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000

# Database (PostgreSQL / Aiven)
# Local:   postgresql://USER:PASSWORD@localhost:5432/nestora?schema=public
# Aiven:   use the full connection string with sslmode=verify-full
DATABASE_URL=

# CORS — must match the frontend origin exactly (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=

# JWT token expiry duration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Cookie signing secret — use a separate strong random value
# Generate: openssl rand -base64 64
COOKIE_SECRET=

# ── Payments (Phase 6) ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# ── Image storage (Phase 4) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMS provider (Phase 3 — optional) ─────────────────────────────────
# Configure one of these to enable real password reset emails/SMS.
# Until configured, reset tokens are only returned in development responses.
# Example for Resend: https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com


