generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum ApartmentStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  DECLINED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  RETRY_PENDING
  BOUNCED
}

enum BlockType {
  HOST_BLOCK
  MAINTENANCE
  RENOVATION
  PERSONAL_USE
  OTHER
}

enum NotificationCategory {
  BOOKINGS
  PAYMENTS
  APARTMENTS
  AVAILABILITY
  REFUNDS
  SUPPORT
  SYSTEM
}

enum SupportTicketCategory {
  BOOKING_ISSUE
  PAYMENT_ISSUE
  CANCELLATION
  REFUND
  APARTMENT_ISSUE
  GENERAL_ENQUIRY
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  RESTORE
  STATUS_CHANGE
  REFUND
}

// ---------------------------------------------------------------------------
// User — Phase 3 (Authentication)
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  fullName     String
  firstName    String?
  lastName     String?
  email        String? @unique
  phone        String? @unique
  country      String?
  avatarUrl    String?
  passwordHash String?

  // Stable identity for customers who sign in with Supabase (Google OAuth).
  // Never trust this value from the browser — it is set by the backend after
  // verifying the Supabase access token.
  supabaseUserId String? @unique

  role            Role    @default(CUSTOMER)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  passwordResetToken   String?
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedApartments      Apartment[]               @relation("ApartmentHost")
  reviewedApartments    Apartment[]               @relation("ApartmentReviewer")
  guestBookings         Booking[]                 @relation("BookingGuest")
  statusHistories       BookingStatusHistory[]
  payments             Payment[]
  emailDeliveries      EmailDelivery[]
  emailPreference      EmailPreference?
  cookieConsents        CookieConsent[]
  notifications         Notification[]
  supportTickets       SupportTicket[]            @relation("SupportTicketAuthor")
  assignedTickets      SupportTicket[]            @relation("SupportTicketAssignee")
  ticketMessages       SupportTicketMessage[]
  auditLogs            AuditLog[]
  availabilityBlocks    ApartmentAvailabilityBlock[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Apartment — Phase 4
// ---------------------------------------------------------------------------

model Apartment {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String

  propertyType String
  city         String
  location     String
  address      String

  maxGuests Int
  bedrooms  Int
  bathrooms Int

  pricePerNight Decimal  @db.Decimal(12, 2)
  cleaningFee   Decimal? @db.Decimal(12, 2)
  otherFees     Decimal? @db.Decimal(12, 2)
  otherFeesNote String?

  checkInInfo     String
  checkOutInfo    String
  smokingPolicy   String
  petPolicy       String
  additionalRules String?

  status ApartmentStatus @default(DRAFT)

  rejectionReason String?
  reviewNotes     String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  suspendedAt     DateTime?

  isFeatured  Boolean @default(false)
  isDemo      Boolean @default(false)
  rating      Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)

  hostId       String
  reviewedById String?

  host       User  @relation("ApartmentHost", fields: [hostId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApartmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  images             ApartmentImage[]
  amenities          ApartmentAmenity[]
  bookings           Booking[]
  availabilityBlocks ApartmentAvailabilityBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([status])
  @@index([city])
  @@index([pricePerNight])
  @@index([isDemo])
  @@map("apartments")
}

model ApartmentImage {
  id          String  @id @default(cuid())
  apartmentId String
  url         String
  publicId    String?
  altText     String?
  position    Int     @default(0)
  isPrimary   Boolean @default(false)

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([apartmentId])
  @@map("apartment_images")
}

model Amenity {
  id   String  @id @default(cuid())
  name String  @unique
  slug String  @unique
  icon String?

  apartments ApartmentAmenity[]

  createdAt DateTime @default(now())

  @@map("amenities")
}

model ApartmentAmenity {
  apartmentId String
  amenityId   String

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  amenity   Amenity   @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([apartmentId, amenityId])
  @@index([amenityId])
  @@map("apartment_amenities")
}

// ---------------------------------------------------------------------------
// Booking — Phase 5
// ---------------------------------------------------------------------------

model Booking {
  id               String        @id @default(cuid())
  bookingReference String        @unique
  guestId          String?
  apartmentId      String
  status           BookingStatus @default(PENDING)

  // Guest booking details (no account required). These are also populated for
  // legacy account bookings when available so hosts/admins always see the
  // traveller's contact details.
  guestFirstName  String?
  guestLastName   String?
  guestEmail      String?
  guestPhone      String?
  guestCountry    String?
  specialRequests String?
  arrivalTime     String?
  additionalNotes String?

  // Secure, token-based access for guests who do not have an account.
  // Only a SHA-256 hash of the token is stored.
  bookingAccessTokenHash      String?
  bookingAccessTokenExpiresAt DateTime?
  bookingAccessTokenRevokedAt DateTime?
  termsAcceptedAt             DateTime?

  checkIn        DateTime
  checkOut       DateTime
  numberOfGuests Int
  numberOfNights Int

  nightlyPriceSnapshot   Decimal  @db.Decimal(12, 2)
  accommodationSubtotal  Decimal  @db.Decimal(12, 2)
  cleaningFeeSnapshot    Decimal? @db.Decimal(12, 2)
  additionalFeesSnapshot Decimal? @db.Decimal(12, 2)
  totalAmount            Decimal  @db.Decimal(12, 2)
  currency               String   @default("NGN")

  expiresAt DateTime?

  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      String?

  adminNotes String?

  guest     User?     @relation("BookingGuest", fields: [guestId], references: [id], onDelete: SetNull)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  statusHistory   BookingStatusHistory[]
  payments        Payment[]
  emailDeliveries EmailDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([apartmentId])
  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([bookingReference])
  @@index([guestEmail])
  @@index([bookingAccessTokenHash])
  @@map("bookings")
}

model BookingStatusHistory {
  id          String        @id @default(cuid())
  bookingId   String
  status      BookingStatus
  note        String?
  changedById String?

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

// ---------------------------------------------------------------------------
// Payment — Phase 6
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  userId            String?
  paymentReference  String        @unique
  paystackReference String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")
  status            PaymentStatus @default(INITIALIZED)
  paymentMethod     String?
  gatewayResponse   String?
  paidAt            DateTime?
  failureReason     String?
  metadata          Json?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  refunds         RefundRequest[]
  emailDeliveries EmailDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([paystackReference])
  @@map("payments")
}

model WebhookEvent {
  id        String  @id @default(cuid())
  provider  String  @default("paystack")
  eventId   String  @unique
  event     String
  payload   Json
  processed Boolean @default(false)
  error     String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([eventId])
  @@index([processed])
  @@map("webhook_events")
}

model RefundRequest {
  id                String       @id @default(cuid())
  paymentId         String
  requestedById     String
  amount            Decimal      @db.Decimal(12, 2)
  reason            String
  status            RefundStatus @default(REQUESTED)
  adminNote         String?
  paystackRefundRef String?
  resolvedAt        DateTime?
  resolvedById      String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("refund_requests")
}

model EmailDelivery {
  id                String              @id @default(cuid())
  userId            String?
  bookingId         String?
  paymentId         String?
  templateName      String
  recipient         String
  subject           String
  status            EmailDeliveryStatus @default(QUEUED)
  attempts          Int                 @default(0)
  lastError         String?
  providerMessageId String?             @unique
  idempotencyKey    String              @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  nextRetryAt       DateTime?
  payload           Json

  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking       Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  webhookEvents EmailWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([nextRetryAt])
  @@map("email_deliveries")
}

model EmailWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("brevo")
  eventId     String    @unique
  event       String
  deliveryId  String?
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  delivery EmailDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([processed])
  @@map("email_webhook_events")
}

model EmailPreference {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  promotionalEmailsEnabled Boolean   @default(false)
  consentGivenAt           DateTime?
  unsubscribedAt           DateTime?
  consentSource            String?
  unsubscribeToken         String    @unique @default(cuid())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_preferences")
}

model CookieConsent {
  id            String   @id @default(cuid())
  userId        String?
  sessionToken  String?
  necessary     Boolean  @default(true)
  functional    Boolean  @default(false)
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  policyVersion String   @default("1.0")
  consentedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionToken])
  @@map("cookie_consents")
}

// ---------------------------------------------------------------------------
// Apartment Availability Block — Phase 7 (Availability Calendar)
// ---------------------------------------------------------------------------

model ApartmentAvailabilityBlock {
  id          String    @id @default(cuid())
  apartmentId String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  blockType   BlockType @default(HOST_BLOCK)
  createdById String?

  apartment  Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apartmentId])
  @@index([startDate, endDate])
  @@map("apartment_availability_blocks")
}

// ---------------------------------------------------------------------------
// Notification — Phase 7 (Notification Center)
// ---------------------------------------------------------------------------

model Notification {
  id         String               @id @default(cuid())
  userId     String
  category   NotificationCategory
  title      String
  message    String
  link       String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  metadata   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([category])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Support Ticket — Phase 7 (Customer Support)
// ---------------------------------------------------------------------------

model SupportTicket {
  id              String               @id @default(cuid())
  ticketReference String               @unique
  fullName        String
  email           String
  phone           String?
  bookingReference String?
  category        SupportTicketCategory
  subject        String
  status          SupportTicketStatus   @default(OPEN)
  assignedToId    String?

  // Nullable for guest-created tickets (no account required)
  authorId        String?

  author    User?  @relation("SupportTicketAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages SupportTicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([email])
  @@index([bookingReference])
  @@index([assignedToId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String  @id @default(cuid())
  ticketId    String
  body        String
  senderType  String  @default("CUSTOMER")
  senderId    String?
  senderName  String?
  isInternal  Boolean @default(false)

  ticket  SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender  User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([senderType])
  @@map("support_ticket_messages")
}

// ---------------------------------------------------------------------------
// Audit Log — Phase 7 (Admin Actions)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  resource    String
  resourceId  String?
  description String
  metadata    Json?
  performedById String?

  performedBy User? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([resource, resourceId])
  @@index([performedById])
  @@index([createdAt])
  @@map("audit_logs")
}

// Database-backed job queue for persistent scheduled tasks
model JobQueue {
  id          String    @id @default(cuid())
  jobType     String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime
  lastError   String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([jobType])
  @@map("job_queue")
}
